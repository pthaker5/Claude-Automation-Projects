## ════════════════════════════════════════════════════════════════
##  DC&E Billing Audit — configuration
##  Copy to .env (start.bat/start.sh does this for you) and fill in.
## ════════════════════════════════════════════════════════════════

## ── EDW connection (DEFAULT: on-prem, Windows auth) ───────────────
## This is the connection that works. The Azure endpoint below is blocked
## by VPN/firewall (TLS prelogin / 10054 errors), so leave EDW_AUTH=trusted.
EDW_SERVER=az-bwprod.chemlogix.com
EDW_DB=CLXDW
EDW_PORT=1433
EDW_AUTH=trusted            # trusted = your Windows login (on-prem) | sp = Azure service principal
EDW_ENCRYPT=yes             # if an old server fails TLS prelogin, try: optional
EDW_TRUST_CERT=yes
EDW_LOGIN_TIMEOUT=60

## ── Azure SQL service principal (ONLY if EDW_AUTH=sp) ─────────────
## Not needed for on-prem/trusted. The Azure dev server is firewall-blocked.
# EDW_SP_TENANT_ID=your-tenant-id
# EDW_SP_CLIENT_ID=your-sp-client-id
# EDW_SP_CLIENT_SECRET=your-sp-client-secret

## ── Flask ─────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-any-random-string
